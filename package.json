{
	"name": "favigen",
	"version": "1.2.1",
	"description": "Library-first favicon and web app icon generator for bundlers and other integrating applications.",
	"type": "module",
	"scripts": {
		"build": "node scripts/build.mjs",
		"prepack": "node scripts/build.mjs",
		"prepublishOnly": "pnpm test",
		"test": "pnpm run typecheck && pnpm run test:unit",
		"test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config config/jest.config.cjs --runInBand --coverage",
		"watch:test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config config/jest.config.cjs --watch",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"test:lint": "eslint src",
		"test:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#CHANGELOG.md\"",
		"test:spelling": "cspell --config ./cSpell.json \"{README.md,.github/*.md,src/**/*.ts,docs/**/*.md}\"",
		"doc:html": "typedoc --entryPoints src/index.ts --out build/docs",
		"doc:json": "typedoc --entryPoints src/index.ts --json build/docs/typedoc.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/josh-hemphill/favigen.git"
	},
	"keywords": [
		"favicon",
		"favicons",
		"icons",
		"pwa",
		"manifest",
		"webmanifest",
		"generator",
		"library",
		"bundler",
		"typescript"
	],
	"maintainers": [
		{
			"name": "Joshua Hemphill",
			"email": "jhemphill@tecnicocorp.com",
			"url": "https://joshuahemphill.com"
		}
	],
	"author": {
		"name": "Joshua Hemphill",
		"email": "jhemphill@tecnicocorp.com",
		"url": "https://joshuahemphill.com"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/josh-hemphill/favigen/issues"
	},
	"homepage": "https://github.com/josh-hemphill/favigen#readme",
	"files": [
		"dist",
		"mod.ts",
		"CHANGELOG.md",
		"LICENSE",
		"SECURITY.md",
		"README.md",
		"docs/favigen-design.md"
	],
	"main": "./dist/cjs/index.js",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		}
	},
	"dependencies": {
		"jimp": "^1.7.0",
		"xmlbuilder2": "^4.0.3",
		"sharp": "0.35.5",
		"@xmldom/xmldom": "^0.9.12",
		"subslate": "^1.0.0"
	},
	"types": "./dist/index.d.ts",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.20.5",
		"cspell": "^10.5.2",
		"eslint": "^10.15.0",
		"jest": "^30.5.2",
		"markdownlint-cli2": "^0.24.2",
		"ts-jest": "^29.4.15",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@10.34.9"
}
